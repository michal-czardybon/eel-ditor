      <StreamGeometry x:Key="IconHistory">M13 3a9 9 0 0 0-9 9H1l4 4 4-4H6a7 7 0 1 1 2 4.9l-1.4 1.4A9 9 0 1 0 13 3zm-1 5v5l4.3 2.5.7-1.2-3.5-2.1V8z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Classic, always visible scrollbars (no overlay auto-hide). -->
  <!-- Menus at the Windows standard size (Segoe UI 9 pt = 12 px); Fluent uses 14 px. -->
  <Style Selector="Menu, ContextMenu, MenuItem">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- Tooltips stay on one line (paths); long text still fits on screen. -->
  <Style Selector="ToolTip">
    <Setter Property="MaxWidth" Value="1400" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Compact sidebar tabs. -->
  <Style Selector="TabControl.side TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="TabControl.side">
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Open-files panel: a close button appears on the hovered row, in place of the git letter. -->
  <Style Selector="Button.rowClose">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.fileRow:pointerover Button.rowClose">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Grid.fileRow:pointerover TextBlock.gitBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Git state of files in the open-files panel. -->
  <Style Selector="TextBlock.gitModified">
    <Setter Property="Foreground" Value="{DynamicResource GitModifiedBrush}" />
  </Style>
  <Style Selector="TextBlock.gitAdded">
    <Setter Property="Foreground" Value="{DynamicResource GitAddedBrush}" />
  </Style>
  <Style Selector="TextBlock.gitDeleted">
    <Setter Property="Foreground" Value="{DynamicResource GitDeletedBrush}" />
  </Style>
  <Style Selector="TextBlock.gitConflict">
    <Setter Property="Foreground" Value="{DynamicResource GitConflictBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.tool PathIcon, ToggleButton.tool PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Border.separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="5,4" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.status">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.statusSep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
