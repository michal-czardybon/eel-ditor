      <StreamGeometry x:Key="IconRevertAll">M7 6V2L0 8.5 7 15v-3L3.5 8.5zM13 6V2L6 8.5l7 6.5v-4c4.4 0 7.6 1.4 10 5-1-5.4-4.2-10-10-10z</StreamGeometry>
      <StreamGeometry x:Key="IconCopyRight">M3 10.5h11V5.5l7 6.5-7 6.5v-5H3z</StreamGeometry>
      <StreamGeometry x:Key="IconCopyLeft">M21 10.5H10V5.5L3 12l7 6.5v-5h11z</StreamGeometry>
      <StreamGeometry x:Key="IconCopyAllRight">M3 6h3l6 6-6 6H3l6-6zM11 6h3l6 6-6 6h-3l6-6z</StreamGeometry>
      <StreamGeometry x:Key="IconCopyAllLeft">M21 6h-3l-6 6 6 6h3l-6-6zM13 6h-3l-6 6 6 6h3l-6-6z</StreamGeometry>
